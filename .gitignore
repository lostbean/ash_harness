# Mix build/dependency artifacts — also catches nested child packages
# under `benchmarks/*/` and `examples/*/`, each of which has its own
# Mix project. Unanchored so they match at any directory depth.
_build/
cover/
deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
ash_harness-*.tar

# Dialyzer PLT files.
*.plt
.dialyzer/

# Temporary files, for example, from tests.
/tmp/
/.direnv

# Claude Code harness runtime state.
.claude/scheduled_tasks.lock

# Editor / OS clutter.
.DS_Store
.vscode/
.idea/
*.swp
*~
